# Committed template - documents the keys .env must define. No real values here.
#
# Clay public developer API (https://api.clay.com/public/v0)
# Create at: Settings -> Account -> API keys (beta)
# Sent as the `clay-api-key` request header.
CLAY_PUBLIC_API_KEY=
CLAY_WORKSPACE_ID=

# Firecrawl.dev scrape API (https://api.firecrawl.dev/v2) - bronze/firecrawl/
# Sent as `Authorization: Bearer <key>`.
FIRECRAWL_API_KEY=

# Apify API (https://api.apify.com/v2) - bronze/apify/
# Sent as `Authorization: Bearer <token>`.
APIFY_API_TOKEN=

# Prospeo API (https://api.prospeo.io) - bronze/prospeo/
# Sent as the `X-KEY` header (not Authorization: Bearer).
PROSPEO_API_KEY=

# --- Not yet wired up. ---
# SERPAPI_API_KEY=
